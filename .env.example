# ============================================
# Iris Telegram Bot — переменные окружения
# ============================================
# Скопируй этот файл в .env и заполни значения:
#     cp .env.example .env
#     nano .env
# ============================================


# --- Обязательные ---

# Токен бота от @BotFather
# Получить: https://t.me/BotFather → /newbot
BOT_TOKEN=


# --- Опциональные ---

# ID супер-админов через запятую (без пробелов)
ADMIN_IDS=

# ID канала для логов (бот должен быть админом канала)
LOG_CHANNEL_ID=

# Прокси для обхода блокировок
# Формат: socks5://user:pass@host:port
PROXY_URL=
