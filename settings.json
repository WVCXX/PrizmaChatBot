{
    "varnLimit": 100, //варн лимит, иными словами лимит предупреждений до автобана
    "DKpovisit": 4, //доступ к команде "повысить". То-есть 4 только старший админ или создатель могут повышать человека в роли
    "DKvarn": 1, //доступ к команде "варн". Можно пользоваться начиная с младшего модера
    "DKvarnLimit": 4, //варн лимит. Кто может менять лимит предупреждений. То есть от 4 старший админ и создатель.
    "DKmute": 3, //Доступ к команде мут и с какого "ранга" она доступна 
    "DKsnatvseh": 5, //кто может снять абсолютно всех.
    "DKban": 4, //доступ к команде "бан" 
    "DKkick": 3, //доступ к команде "кик"
